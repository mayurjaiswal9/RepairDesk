# RepairDesk production environment variables.
# Copy this file to .env and fill in the values before running docker compose.
# NEVER commit .env to version control.

# ── Database ────────────────────────────────────────────────────────────────
DB_NAME=repairdesk
DB_USER=repairdesk
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── Default admin (created once on first boot) ───────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_THEN_ROTATE_IN_APP

# ── Docker image version ─────────────────────────────────────────────────────
API_VERSION=latest
